class_name UiSkin
extends RefCounted
## Texture-based style boxes made from the approved design assets
## (text-free versions generated by tools/prepare_assets.py).

## variant: [texture, cap width, text color]
const PILLS := {
	"light": ["res://assets/ui/pill_light.png", 54, UiTheme.NAVY],
	"blue": ["res://assets/ui/pill_blue.png", 55, Color.WHITE],
	"green": ["res://assets/ui/pill_green.png", 51, Color.WHITE],
	"red": ["res://assets/ui/pill_red.png", 51, Color.WHITE],
	"cyan": ["res://assets/ui/pill_cyan.png", 50, UiTheme.NAVY],
	"purple": ["res://assets/ui/pill_purple.png", 50, UiTheme.NAVY],
	"gray": ["res://assets/ui/pill_gray.png", 40, Color.WHITE],
}

const PANELS := {
	"main": ["res://assets/ui/Settings_Panel_Main.png", 80],
	"row_blue": ["res://assets/ui/Settings_Row_Blue.png", 44],
	"row_purple": ["res://assets/ui/Settings_Row_Purple.png", 44],
	"row_gold": ["res://assets/ui/Settings_Row_Gold.png", 44],
	"stat_blue": ["res://assets/ui/Lernzeit_Progress_Panel_Blue.png", 64],
	"stat_purple": ["res://assets/ui/Lernzeit_Progress_Panel_Purple.png", 64],
	"stat_gold": ["res://assets/ui/Lernzeit_Progress_Panel_Gold.png", 64],
	"wide": ["res://assets/ui/Lernzeit_Progress_Panel_Wide.png", 50],
}

static var _cache := {}


static func pill(variant: String) -> StyleBoxTexture:
	var key := "pill_" + variant
	if not _cache.has(key):
		var spec: Array = PILLS.get(variant, PILLS["light"])
		var sb := StyleBoxTexture.new()
		sb.texture = load(spec[0])
		var h: int = sb.texture.get_height()
		sb.texture_margin_left = spec[1]
		sb.texture_margin_right = spec[1]
		sb.texture_margin_top = h / 2 - 4
		sb.texture_margin_bottom = h / 2 - 4
		sb.content_margin_left = 34
		sb.content_margin_right = 34
		sb.content_margin_top = 14
		sb.content_margin_bottom = 14
		_cache[key] = sb
	return _cache[key]


static func pill_text_color(variant: String) -> Color:
	return PILLS.get(variant, PILLS["light"])[2]


static func panel(name: String, content_margin: int = -1) -> StyleBoxTexture:
	var key := "panel_%s_%d" % [name, content_margin]
	if not _cache.has(key):
		var spec: Array = PANELS[name]
		var sb := StyleBoxTexture.new()
		sb.texture = load(spec[0])
		var m: int = spec[1]
		sb.texture_margin_left = m
		sb.texture_margin_right = m
		sb.texture_margin_top = m
		sb.texture_margin_bottom = m
		var cm := content_margin if content_margin >= 0 else m
		sb.content_margin_left = cm
		sb.content_margin_right = cm
		sb.content_margin_top = cm * 0.6
		sb.content_margin_bottom = cm * 0.6
		_cache[key] = sb
	return _cache[key]


## Glass row (settings / parents / details): light translucent card with a white rim.
static func row(tint: String = "blue", highlighted: bool = false) -> StyleBoxFlat:
	var key := "row_%s_%s" % [tint, highlighted]
	if not _cache.has(key):
		var sb := StyleBoxFlat.new()
		var base: Color = {"blue": Color(0.86, 0.93, 1.0), "purple": Color(0.93, 0.88, 1.0), "gold": Color(1.0, 0.94, 0.78)}.get(tint, Color(0.86, 0.93, 1.0))
		base.a = 0.62 if highlighted else 0.42
		sb.bg_color = base
		sb.set_corner_radius_all(26)
		sb.set_border_width_all(3 if highlighted else 2)
		sb.border_color = Color(1, 1, 1, 0.95) if highlighted else Color(1, 1, 1, 0.7)
		sb.shadow_color = Color(0.1, 0.2, 0.6, 0.18)
		sb.shadow_size = 6
		sb.shadow_offset = Vector2(0, 3)
		sb.content_margin_left = 26
		sb.content_margin_right = 22
		sb.content_margin_top = 12
		sb.content_margin_bottom = 12
		sb.anti_aliasing = true
		_cache[key] = sb
	return _cache[key]


static func track() -> StyleBoxTexture:
	if not _cache.has("track"):
		var sb := StyleBoxTexture.new()
		sb.texture = load("res://assets/ui/track_light.png")
		sb.texture_margin_left = 27
		sb.texture_margin_right = 27
		sb.texture_margin_top = 20
		sb.texture_margin_bottom = 20
		_cache["track"] = sb
	return _cache["track"]


## Small flag icon (drawn, no external art): de = black/red/gold, ru = white/blue/red.
static func flag(code: String) -> Texture2D:
	var key := "flag_" + code
	if _cache.has(key):
		return _cache[key]
	var colors: Array = [Color("111111"), Color("dd0000"), Color("ffce00")] if code == "de" \
		else [Color("ffffff"), Color("0039a6"), Color("d52b1e")]
	var w := 60
	var h := 42
	var img := Image.create(w, h, false, Image.FORMAT_RGBA8)
	var r := 9.0
	for y in h:
		for x in w:
			var c: Color = colors[mini(2, y * 3 / h)]
			# rounded corners + thin light border
			var dx := maxf(0.0, maxf(r - x, x - (w - 1 - r)))
			var dy := maxf(0.0, maxf(r - y, y - (h - 1 - r)))
			var d := sqrt(dx * dx + dy * dy)
			if d > r:
				c.a = 0.0
			elif d > r - 2.0 or x < 2 or y < 2 or x > w - 3 or y > h - 3:
				c = c.lerp(Color(0.85, 0.9, 1.0), 0.6)
			img.set_pixel(x, y, c)
	var tex := ImageTexture.create_from_image(img)
	_cache[key] = tex
	return tex
