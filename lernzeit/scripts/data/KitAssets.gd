static func path(key: String) -> String:
	return TEXTURES[key][0] if TEXTURES.has(key) else ""


static func texture(key: String) -> Texture2D:
	var p := path(key)
	return load(p) if p != "" else null


static func keys_with_prefix(prefix: String) -> Array:
	return TEXTURES.keys().filter(func(k): return k.begins_with(prefix))
